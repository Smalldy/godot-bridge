{
  "name": "dsh-task-center",
  "version": "0.1.0",
  "private": true,
  "description": "DSH (DeepSeek Harness) bundle: a per-project task center — a shared task board with a release queue and file locks, plus the /task command that lets a user tell the agent a discussion has converged into real work.",
  "type": "module",
  "main": "plugin/index.mjs",
  "exports": {
    ".": "./plugin/index.mjs",
    "./client": "./client/client.js"
  },
  "files": [
    "plugin/",
    "client/",
    "cordis.patch.yml"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "task-center",
    "task-board",
    "kanban",
    "agent-collaboration"
  ],
  "scripts": {
    "check": "node ../scripts/check-plugin-contract.mjs --root ."
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": ">=0.1.6-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-llm": {
      "optional": true
    }
  },
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
